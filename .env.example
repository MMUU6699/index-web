# Copy this file and rename to .env

# Server environment variables
PROTECTED_PATHS="/auth/reset-password,/profile" # OPTIONAL, comma separated list of protected paths
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key" # REQUIRED

# Client environment variables
NEXT_PUBLIC_TMDB_ACCESS_TOKEN="your_tmdb_access_token" # REQUIRED, use the v4 access token
NEXT_PUBLIC_SUPABASE_URL="your_supabase_url" # REQUIRED
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key" # REQUIRED
NEXT_PUBLIC_CAPTCHA_SITE_KEY="your_captcha_site_key" # OPTIONAL, enable captcha
NEXT_PUBLIC_AVATAR_PROVIDER_URL="your_avatar_provider_url" # OPTIONAL, user avatar provider

SUPABASE_AUTH_GOOGLE_CLIENT_ID="your_google_client_id"
SUPABASE_AUTH_GOOGLE_SECRET_KEY="your_google_secret_key"

SUPABASE_AUTH_SMTP_HOST="smtp_host"
SUPABASE_AUTH_SMTP_PORT="smtp_port"
SUPABASE_AUTH_SMTP_EMAIL="your_email"
SUPABASE_AUTH_SMTP_PASSWORD="your_password"
